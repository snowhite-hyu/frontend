    "@types/react-router-dom": "^5.3.3",
    "axios": "^1.8.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.7.3",
    "immutability-helper": "^3.1.1",
    "lucide-react": "^0.503.0",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.5.0",
    "react-spinners": "^0.16.1",
    "sonner": "^2.0.3",
