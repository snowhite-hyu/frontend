{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "build": "tsc -b && vite build --mode build",
    "lint": "biome lint --write ./src",
    "format": "biome format --write ./src",
    "check": "biome check --write ./src",
    "swagger-api": "swagger-typescript-api generate -p https://dev.snowhite-hyu.duckdns.org/api/v3/api-docs -o ./src/generated/ -n model.d.ts --no-client",
    "preview": "vite preview"
  },
  "dependencies": {
