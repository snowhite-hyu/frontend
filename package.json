    "swagger-typescript-api": "^13.1.3",
    "tailwindcss-language-server": "^0.0.1",
    "tw-animate-css": "^1.2.8",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.24.1",
    "typescript-language-server": "^4.3.4",
